# Public site URL (production Hostnext domain)
VITE_SITE_URL=https://www.synergytravelsandtour.com

# Frontend payments API base (leave blank locally to use Vite /api proxy)
# On Hostnext static hosting, point this to your Node API host if used:
# VITE_PAYMENTS_API_URL=https://api.synergytravelsandtour.com
VITE_PAYMENTS_API_URL=

# Travel search / comparison providers
# synergy (default) = enquiry-led + partner deeplinks, no fake prices
# kayak | skyscanner = prefer that provider's deeplink adapter
VITE_TRAVEL_PROVIDER=synergy
# Set true ONLY in local/dev to show mock priced results — never in production
VITE_TRAVEL_DEMO_MODE=false
# Set true only when an authorised live inventory API is actually connected
VITE_TRAVEL_PROVIDER_LIVE=false
# Public affiliate IDs for deeplinks/widgets (never put API secrets in VITE_*)
VITE_KAYAK_AFFILIATE_ID=
VITE_SKYSCANNER_AFFILIATE_ID=
# Analytics (optional)
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=

# Server-side travel provider secrets (future Node handlers — never expose to browser)
TRAVEL_PROVIDER=
TRAVEL_PROVIDER_API_KEY=
TRAVEL_PROVIDER_API_SECRET=
TRAVEL_PROVIDER_AFFILIATE_ID=

# Payments API (copy to project root `.env` — loaded by server/index.mjs)
PAYMENT_PORT=4242
CLIENT_URL=https://www.synergytravelsandtour.com
PAYMENT_CURRENCY=gbp
PAYMENT_REFERENCE_PREFIX=STT

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# PayPal — https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Wise transfer details (shown at checkout)
WISE_EMAIL=
WISE_ACCOUNT_DETAILS=

# Revolut transfer details (shown at checkout)
REVOLUT_TAG=
REVOLUT_ACCOUNT_DETAILS=

# Bank account / IBAN (UK or international)
BANK_ACCOUNT_NAME=Synergy Travels & Tour
BANK_NAME=
BANK_SORT_CODE=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=
BANK_BIC=
