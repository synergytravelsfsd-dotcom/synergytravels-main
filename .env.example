# Frontend (optional — leave blank to use Vite proxy to local payments API)
VITE_PAYMENTS_API_URL=

# Payments API (copy to project root `.env` — loaded by server/index.mjs)
PAYMENT_PORT=4242
CLIENT_URL=http://127.0.0.1:5173
PAYMENT_CURRENCY=usd
PAYMENT_REFERENCE_PREFIX=STT

# Stripe — https://dashboard.stripe.com/apikeys
# Debit & credit cards (Visa, Mastercard, Amex, etc.) go through Stripe Checkout
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# PayPal — https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Wise transfer details (shown at checkout)
WISE_EMAIL=
WISE_ACCOUNT_DETAILS=

# Revolut transfer details (shown at checkout)
REVOLUT_TAG=
REVOLUT_ACCOUNT_DETAILS=

# Bank account / IBAN (UK or international)
BANK_ACCOUNT_NAME=Synergy Travels & Tour
BANK_NAME=
BANK_SORT_CODE=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=
BANK_BIC=
